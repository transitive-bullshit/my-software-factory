/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# ide
.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pnpm
.pnpm-store

# local env files
.env
.env.local
local.env
.env.build
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# local work
/work

# environments and third-party checkouts
/.venv
__pycache__/
*.pyc
# the HyperFrames projects (captions/, promo/*) install their own
node_modules/
/.claude/settings.local.json
# HyperFrames' project skills (`npx hyperframes skills update` reinstalls them)
/.claude/skills

# copyrighted source footage, audio and transcripts, the cast's photos and voice references (never committed)
/media
/reference
/transcript

# derived outputs (regenerable)
/frames
/review/dist
/renders
/.cache
/captions/renders
/captions/assets
/promo/*/renders
/promo/.review
# HyperFrames Studio caches
.hyperframes/
.thumbnails/
.waveform-cache/

# safety net: every audio and video file here is copyrighted or derived (use `git add -f` for a deliberate exception)
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.mp4
*.mov
*.webm
*.mkv
